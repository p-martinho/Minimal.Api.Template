@startuml

hide footbox
skinparam sequenceMessageAlign center
skinparam RoundCorner 10
skinparam ParticipantBackgroundColor #LightBlue
skinparam DatabaseBackgroundColor #LightBlue
skinparam ActorBackgroundColor #LightBlue
skinparam EntityBackgroundColor #LightBlue
skinparam SequenceLifeLineBackgroundColor #LightGoldenRodYellow
skinparam SequenceBoxBackgroundColor #White

actor User
participant "Client App" as ClientApp
participant "API" as Api

User -> ClientApp ++ : Create User

    ClientApp -> Api ++ : POST /api/users
    Api --> ClientApp -- : UserApiDto

ClientApp -> User --

User -> ClientApp ++ : Login (username+password)
    
    ClientApp -> Api ++ : POST /connect/token

        Api -> Api ++ : Validate username+password
        Api --

    Api --> ClientApp -- : Access token

ClientApp -> User --

User -> ClientApp ++ : Get User Info

    ClientApp -> Api ++ : GET /api/users/info (access token in header)
    
        Api -> Api ++ : Validate access token
        Api --
    
    Api --> ClientApp -- : UserApiDto

ClientApp -> User --

User -> ClientApp ++ : Create TODO List

    ClientApp -> Api ++ : POST /api/todoLists (access token in header)

        Api -> Api ++ : Validate access token
        Api --

    Api --> ClientApp -- : TodoListApiDto

ClientApp -> User --

@enduml